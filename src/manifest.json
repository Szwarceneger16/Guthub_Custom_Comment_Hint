{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_settingsTitle__",
    "default_icon": {
      "16": "icons/hint-16.png",
      "32": "icons/hint-32.png"
    }
  },
  "icons": {
    "16": "icons/hint-16.png",
    "32": "icons/hint-32.png",
    "48": "icons/hint-48.png",
    "96": "icons/hint-96.png",
    "128": "icons/hint-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "github-custom-comment-hint@szwarceneger16",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
